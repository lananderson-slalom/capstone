{
  "name": "component-workstation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace packages/frontend",
    "build": "npm run build --workspace packages/frontend",
    "test": "npm run test --workspace packages/frontend",
    "typecheck": "npm run typecheck --workspace packages/frontend",
    "test:e2e": "playwright test",
    "test:coverage": "npm run test --workspace packages/frontend -- --coverage",
    "lint": "eslint packages/frontend/src packages/frontend/vite.config.ts playwright.config.ts tests/e2e --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json .prettierrc.json eslint.config.mjs playwright.config.ts packages/frontend tests/e2e README.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=22"
  }
}
